/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; form-action https://news.cryptorevolution.money https://api.cryptorevolution.money; base-uri 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=604800

/dl/*
  X-Robots-Tag: noindex, nofollow
